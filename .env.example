# ============================================================================
# neura-erp-triple7 — instancia dedicada monocliente (Triple 7)
#
# Copiar a .env.local y completar valores. NO commitear .env.local.
# ============================================================================

# ----- Modo de instancia (single_client) -----
NEURA_INSTANCE_MODE=single_client
NEURA_CLIENT_SCHEMA=triple7
NEURA_CLIENT_NAME=Triple 7

# ----- Supabase (self-hosted Coolify, instancia dedicada) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# ----- WhatsApp / Meta Cloud API -----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
# Opcionales (override por env si no se resuelve desde chat_channels):
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_DEFAULT_EMPRESA_ID=
# WHATSAPP_LINK_PHONE_NUMBER=
# NEXT_PUBLIC_WHATSAPP_LINK_PHONE_NUMBER=

# ----- OCR comprobantes -----
GOOGLE_CLOUD_VISION_API_KEY=

# ----- SIFEN (facturación electrónica; opcional según uso) -----
SIFEN_SECRETS_KEY=

# ----- Sorteos -----
QA_SORTEO_TICKET_SECRET=

# ----- Admin bootstrap -----
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# ----- Observabilidad / debug (opcional) -----
# CAMPAIGN_REPLY_LOOKBACK_DAYS=
# PG_POOL_MAX=
# FLOW_TRACE_VERBOSE=
# CHAT_INBOX_OBSERVABILITY=
# OMNICANAL_EQUIPOS_DEBUG=
